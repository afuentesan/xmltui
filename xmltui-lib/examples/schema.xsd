<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <!-- ========================================== -->
    <!-- TIPOS ESTRICTOS BASE                       -->
    <!-- ========================================== -->
    <xs:simpleType name="ratioBase">
        <xs:restriction base="xs:string">
            <xs:pattern value="\d+,\s*\d+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="alignEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="left"/>
            <xs:enumeration value="right"/>
            <xs:enumeration value="center"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="dirEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="horizontal"/>
            <xs:enumeration value="vertical"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="outputEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="str"/>
            <xs:enumeration value="strvec"/>
            <xs:enumeration value="json"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Nuevo: title-position base -->
    <xs:simpleType name="titlePositionEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="top"/>
            <xs:enumeration value="bottom"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Nuevo: flex base -->
    <xs:simpleType name="flexEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="start"/>
            <xs:enumeration value="end"/>
            <xs:enumeration value="center"/>
            <xs:enumeration value="space-around"/>
            <xs:enumeration value="space-between"/>
            <xs:enumeration value="space-evenly"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Nuevo: borders base (Permite top, left, right, bottom separados por coma) -->
    <xs:simpleType name="bordersBase">
        <xs:restriction base="xs:string">
            <!-- Patrón: Una palabra permitida, opcionalmente seguida de coma y otra palabra permitida -->
            <xs:pattern value="(top|bottom|left|right)(\s*,\s*(top|bottom|left|right))*"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ========================================== -->
    <!-- SOPORTE PARA SINTAXIS MINIJINJA EN ATRIBUTOS-->
    <!-- ========================================== -->
    <xs:simpleType name="jinjaAttr">
        <xs:restriction base="xs:string">
            <xs:pattern value=".*\{\{.*\}\}.*"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- TIPOS FINALES (Unión del estricto + Jinja) -->
    <xs:simpleType name="alignType">
        <xs:union memberTypes="alignEnum jinjaAttr"/>
    </xs:simpleType>

    <xs:simpleType name="dirType">
        <xs:union memberTypes="dirEnum jinjaAttr"/>
    </xs:simpleType>

    <xs:simpleType name="outputType">
        <xs:union memberTypes="outputEnum jinjaAttr"/>
    </xs:simpleType>

    <xs:simpleType name="ratioType">
        <xs:union memberTypes="ratioBase jinjaAttr"/>
    </xs:simpleType>

    <xs:simpleType name="uintType">
        <xs:union memberTypes="xs:unsignedInt jinjaAttr"/>
    </xs:simpleType>

    <xs:simpleType name="titlePositionType">
        <xs:union memberTypes="titlePositionEnum jinjaAttr"/>
    </xs:simpleType>

    <xs:simpleType name="flexType">
        <xs:union memberTypes="flexEnum jinjaAttr"/>
    </xs:simpleType>

    <xs:simpleType name="bordersType">
        <xs:union memberTypes="bordersBase jinjaAttr"/>
    </xs:simpleType>

    <!-- ========================================== -->
    <!-- GRUPOS Y ATRIBUTOS COMUNES                 -->
    <!-- ========================================== -->
    <xs:attributeGroup name="commonBodyAttributes">
        <xs:attribute name="id" type="xs:string"/>
        <xs:attribute name="class" type="xs:string"/>
        <xs:attribute name="fill" type="uintType"/>
        <xs:attribute name="percentage" type="uintType"/>
        <xs:attribute name="min" type="uintType"/>
        <xs:attribute name="max" type="uintType"/>
        <xs:attribute name="length" type="uintType"/>
        <xs:attribute name="ratio" type="ratioType"/>
        <xs:attribute name="refresh-sec" type="uintType"/>
        <xs:attribute name="refresh-ms" type="uintType"/>
        <xs:anyAttribute namespace="##any" processContents="skip"/>
    </xs:attributeGroup>

    <!-- Todos los elementos anidables -->
    <xs:group name="bodyElements">
        <xs:choice>
            <xs:element ref="layout"/>
            <xs:element ref="border"/> <!-- Incluido aquí para que pueda anidarse en todos lados -->
            <xs:element ref="line"/>
            <xs:element ref="span"/>
            <xs:element ref="input"/>
            <xs:element ref="a"/>
            <xs:element ref="button"/>
            <xs:element ref="command"/>
        </xs:choice>
    </xs:group>

    <!-- ========================================== -->
    <!-- ELEMENTOS DEL BODY, LAYOUT, BORDER, TEMPLATE -->
    <!-- ========================================== -->
    <xs:element name="template">
        <xs:complexType mixed="true">
            <xs:group ref="bodyElements" minOccurs="0" maxOccurs="unbounded"/>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="src" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="layout">
        <xs:complexType mixed="true">
            <xs:group ref="bodyElements" minOccurs="0" maxOccurs="unbounded"/>
            <xs:attribute name="dir" type="dirType"/>
            <xs:attribute name="flex" type="flexType"/> <!-- Se ha añadido flex -->
            <xs:attributeGroup ref="commonBodyAttributes"/>
        </xs:complexType>
    </xs:element>

    <!-- Nuevo elemento border -->
    <xs:element name="border">
        <xs:complexType mixed="true">
            <xs:group ref="bodyElements" minOccurs="0" maxOccurs="unbounded"/>
            <xs:attribute name="title" type="xs:string"/>
            <xs:attribute name="title-position" type="titlePositionType"/>
            <xs:attribute name="title-align" type="alignType"/> <!-- Comparte tipo con align -->
            <xs:attribute name="dir" type="dirType"/>
            <xs:attribute name="flex" type="flexType"/>
            <xs:attribute name="borders" type="bordersType"/>
            <xs:attributeGroup ref="commonBodyAttributes"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="line">
        <xs:complexType mixed="true">
            <xs:sequence>
                <xs:element ref="span" minOccurs="0" maxOccurs="unbounded"/>
            </xs:sequence>
            <xs:attribute name="align" type="alignType"/>
            <xs:attributeGroup ref="commonBodyAttributes"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="span">
        <xs:complexType mixed="true">
            <xs:attributeGroup ref="commonBodyAttributes"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="input">
        <xs:complexType>
            <xs:attribute name="type" type="xs:string"/>
            <xs:attribute name="value" type="xs:string"/>
            <xs:attribute name="align" type="alignType"/>
            <xs:attributeGroup ref="commonBodyAttributes"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="a">
        <xs:complexType mixed="true">
            <xs:attribute name="src" type="xs:string"/>
            <xs:attribute name="align" type="alignType"/>
            <xs:attributeGroup ref="commonBodyAttributes"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="button">
        <xs:complexType mixed="true">
            <xs:attribute name="enter" type="xs:string"/>
            <xs:attribute name="align" type="alignType"/>
            <xs:attribute name="enter-replace-childs" type="xs:string"/>
            <xs:attribute name="enter-replace-node" type="xs:string"/>
            <xs:attribute name="enter-change-value" type="xs:string"/>
            <xs:attribute name="enter-data" type="xs:string"/>
            <xs:attributeGroup ref="commonBodyAttributes"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="command">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="template" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="exec" type="xs:string"/>
            <xs:attribute name="template" type="xs:string"/>
            <xs:attribute name="child-type" type="xs:string"/>
            <xs:attribute name="child-align" type="alignType"/>
            <xs:attribute name="child-dir" type="dirType"/>
            <xs:attribute name="output" type="outputType"/>
            <xs:attributeGroup ref="commonBodyAttributes"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="body">
        <xs:complexType mixed="true">
            <xs:group ref="bodyElements" minOccurs="0" maxOccurs="unbounded"/>
            <xs:attribute name="dir" type="dirType"/>
            <xs:attribute name="flex" type="flexType"/> <!-- Se ha añadido flex -->
            <xs:attributeGroup ref="commonBodyAttributes"/>
        </xs:complexType>
    </xs:element>

    <!-- ========================================== -->
    <!-- ELEMENTOS DEL HEAD                         -->
    <!-- ========================================== -->
    <xs:element name="style">
        <xs:complexType mixed="true">
            <xs:attribute name="src" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="env">
        <xs:complexType mixed="true">
            <xs:attribute name="name" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="env-data">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="arg" type="xs:string"/>

    <xs:element name="arg-data">
        <xs:complexType>
            <xs:attribute name="name" type="xs:string" use="required"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="envs">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="env"/>
                <xs:element ref="env-data"/>
            </xs:choice>
        </xs:complexType>
    </xs:element>

    <xs:element name="args">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="arg"/>
                <xs:element ref="arg-data"/>
            </xs:choice>
        </xs:complexType>
    </xs:element>

    <xs:element name="code">
        <xs:complexType>
            <xs:sequence minOccurs="0">
                <xs:element ref="envs" minOccurs="0"/>
                <xs:element ref="args" minOccurs="0"/>
            </xs:sequence>
            <xs:attribute name="name" type="xs:string"/>
            <xs:attribute name="command" type="xs:string"/>
            <xs:attribute name="src" type="xs:string"/>
        </xs:complexType>
    </xs:element>

    <xs:element name="head">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element ref="style"/>
                <xs:element ref="code"/>
                <xs:element ref="template"/>
            </xs:choice>
        </xs:complexType>
    </xs:element>

    <!-- ========================================== -->
    <!-- ELEMENTO RAÍZ                              -->
    <!-- ========================================== -->
    <xs:element name="rtml">
        <xs:complexType>
            <xs:sequence>
                <xs:element ref="head" minOccurs="0"/>
                <xs:element ref="body"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>