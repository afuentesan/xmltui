<rtml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xsi:noNamespaceSchemaLocation="schema.xsd">
    
    <head>

        <code command="date" name="date" />

        <code command="echo" name="echo">
            <args>
                <arg-var name="saludo" />
                <arg-var name="nombre" />
                <arg-var name="sufijo" />
            </args>
        </code>

        <template name="line-echo">
            <line>{{ctx}}</line>
        </template>

        <template name="nombre-hora">
            <line>{{ st.txt }}</line>
            <line>{{ ctx }}</line>
        </template>

        <code command="/usr/bin/bash" name="random">
            <args>
                <arg>-c</arg>
                <arg>
                    <![CDATA[ 
                    echo $RANDOM
                    ]]>
                </arg>
            </args>
        </code>

        <code command="/usr/bin/bash" name="lista-nums">
            <args>
                <arg>-c</arg>
                <arg>
                    <![CDATA[ 
                    echo $'uno\ndos\ntres'
                    printf '%s' "$(date)"
                    ]]>
                </arg>
            </args>
        </code>

        <code command="node" name="obj">
            <args>
                <arg>-e</arg>
                <arg>
                    <![CDATA[ 

                    const obj = {
                        nombre : "Pepe",
                        apellidos : "Botica"
                    };

                    console.log( JSON.stringify( obj ) );

                    ]]>
                </arg>
            </args>
        </code>
    </head>

    <state>
        <st-var path="/saludo" value="Hola" type="str" />
        <st-var path="txt" value="Ángel" type="str" />
        <st-command id="sufijo" path="/sufijo" exec="random" output="str" />
        <st-command id="change-txt" path="/txt" exec="random" output="str" />
        <st-command id="data" path="data" exec="obj" type="json" on-init="true" />
    </state>

    <body>
        <input id="txt" value="tururu" enter="echo" enter-template="line-echo" enter-replace-childs="line-container" enter-args="saludo, nombre:txt, sufijo" />

        <layout id="line-container">
            <line>Que pasa</line>
        </layout>

        <command template="nombre-hora" exec="date" reload-with-st-path="txt" />

        <button enter-refresh-st="sufijo">Actualiza sufijo</button>

        <button enter-refresh-st="change-txt">Actualiza txt</button>

        <p bg="Red">
            <command exec="lista-nums" refresh-sec="1" />
        </p>

        <select bg="Green">
            <command exec="lista-nums" output="strvec" reload-with-st-path="txt">
                <template>
                    {% for l in ctx %}
                        <option value="{{ l }}">{{ l }}</option>
                    {% endfor %}
                    <option value="{{ st.txt }}">{{ st.txt }}</option>
                </template>
            </command>
        </select>

        <line>
            <st reload-with-st-path="txt,sufijo">
                <template>
                    Hola {{ st.txt }} <span bg="Red">{{ st.sufijo }}</span>
                </template>
            </st>
        </line>

        <line>
            <st reload-with-st-path="data" id="st-data">
                <template>
                    Data: {{ st.data.nombre }} {{ st.data.apellidos }}
                </template>
            </st>
        </line>

        <button enter-refresh-st="data">Actualiza data</button>
    </body>

</rtml>