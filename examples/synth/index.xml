<rtml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xsi:noNamespaceSchemaLocation="../../xmltui-lib/examples/schema.xsd"
>
    <head>
        <style>
            {
                ".red" : {
                    "fg" : "#bb2222"
                },
                "input, select" : {
                    "bg" : "#333333",
                    "fill" : "1",
                    "align" : "center",
                    "padding-top" : 3,
                    "padding-left" : "2",
                    "flex" : "space-between",
                    "dir" : "vertical"
                },
                "layout" : {
                    "dir" : "horizontal",
                    "flex" : "center"
                },
                "line" : {
                    "align" : "center"
                }
            }
        </style>
