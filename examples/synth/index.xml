<rtml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xsi:noNamespaceSchemaLocation="../../xmltui-lib/examples/schema.xsd"
>
    <head>
        <style>
            {
                ".red" : {
                    "fg" : "#bb2222"
                }
            }
        </style>
        <code command="/usr/bin/node" name="actions">
            <args>
                <arg>-e</arg>
                <arg>
                    <![CDATA[ 
                        const options = {
                            options : [
                                {
                                    value : "new_partial",
                                    text : "Agregar <span class='red'>parciales</span>"
                                },
                                {
                                    value : "new_fx",
                                    text : "Agregar <span class='red'>efectos</span>"
                                }
                            ]
                        };

                        console.log( JSON.stringify( options ) );
                    ]]>
                </arg>
            </args>
        </code>

        <code command="echo" name="ir_a_opcion">
            <args>
                <arg-value name="opcion" />
            </args>
        </code>
    </head>

    <body>

        <command output="json" exec="actions">
            <template>
                <select dropdown="false" align="center" id="opcion" enter-src="{% raw %}{{ value.opcion }}{% endraw %}" set-focus="true">
                    {% for option in ctx.options %}
                        <option value="{{ option.value }}">{{ option.text }}</option>
                    {% endfor %}
                </select>
            </template>
        </command>
    </body>

</rtml>