        <code command="echo" name="ir_a_opcion">
            <args>
                <arg-value name="opcion" />
            </args>
        </code>
    </head>

    <body dir="vertical" flex="center">

        <command output="json" exec="actions" dir="horizontal" flex="center" length="15">
            <template>
                <select length="25" padding="1" dropdown="false" align="center" id="opcion" enter-src="{% raw %}{{ value.opcion }}{% endraw %}" set-focus="true">
                    {% for option in ctx.options %}
                        <option value="{{ option.value }}">{{ option.text }}</option>
                    {% endfor %}
                </select>
            </template>
        </command>

        <layout class="prueba" bg="#001100">
            <line>Hola</line>
        </layout>
    </body>
