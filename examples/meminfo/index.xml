<rtml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xsi:noNamespaceSchemaLocation="../../xmltui-lib/examples/schema.xsd"
>

<!-- xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/afuentesan/xmltui/refs/heads/main/xmltui-lib/examples/schema.xsd" -->
    
	<head>
		<code command="/usr/bin/head" name="meminfo">
			<args>
				<arg>-3</arg>
				<arg>/proc/meminfo</arg>
			</args>
		</code>
		
		<template name="meminfo">
			<layout>
				<line align="center">Meminfo</line>
			</layout>
			{% for item in ctx %}
			<layout>
				{% for column in item | split( ":" ) %}
					<line align="{{ 'right' if loop.index0 == 0 else 'left' }}">{{ column | trim }}</line>
				{% endfor %}
			</layout>
			{% endfor %}
		</template>
	</head>
    <body dir="vertical">
		<layout></layout>
		<!--
		<command exec="meminfo" refresh-sec="1" child-type="layout" child-dir="vertical" length="3" output="strvec">
			<template>
				{% for item in ctx %}
				<layout>
					<line align="center">{{ item }}</line>
				</layout>
				{% endfor %}
			</template>
		</command>
		-->
		<command exec="meminfo" refresh-sec="1" child-type="layout" child-dir="vertical" length="4" output="strvec" template="meminfo" />
		<layout></layout>
    </body>
</rtml>