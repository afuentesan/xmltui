<rtml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xsi:noNamespaceSchemaLocation="../../xmltui-lib/examples/schema.xsd"
>

<!-- xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/afuentesan/xmltui/refs/heads/main/xmltui-lib/examples/schema.xsd" -->
    
	<head>
		<code command="/usr/bin/head" name="meminfo">
			<args>
				<arg>-3</arg>
				<arg>/proc/meminfo</arg>
			</args>
		</code>
		
		<style>
			{
				".red" : {
					"fg" : "#AA3333"
				},
				".blue" : {
					"fg" : "#6666AA"
				},
				".title" : {
					"add_modifier" : "UNDERLINED"
				},
				".border:title" : {
					"fg" : "#33AA33"
				},
				".border:border" : {
					"fg" : "#3333AA"
				},
				"layout, body" : {
					"dir" : "horizontal",
					"bg" : "#001100"
				}
			}
		</style>
		<template name="meminfo">
			{% for item in ctx %}
			{% if item | trim != "" %}
			<layout flex="center">
				{% for column in item | split( ":" ) %}
					<layout>
					<line 
						align="{{ 'right' if loop.index0 == 0 else 'left' }}"
						class="{{ 'blue' if loop.index0 == 0 else 'red' }}"
						padding-right="1"
						min="1"
					>
						{{ column | trim }}{{ ': ' if loop.index0 == 0 else '' }}
					</line>
					</layout>
				{% endfor %}
			</layout>
			{% endif %}
			{% endfor %}
		</template>
	</head>
    <body flex="center" dir="vertical">
		<layout dir="horizontal" length="5" flex="center">
			<border title=" Meminfo " length="50" class="border" title-position="top" title-align="center" borders="top,bottom">
				<command exec="meminfo" refresh-sec="1" child-type="layout" child-dir="vertical" output="strvec" template="meminfo" />
			</border>
		</layout>
    </body>
</rtml>