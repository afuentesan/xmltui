<rtml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
      xsi:noNamespaceSchemaLocation="../../xmltui-lib/examples/schema.xsd"
>
    <head>
        <style>
            ".red" : {
                "fg" : "#ff0000"
            },
            "p:focus" : {
                "bg" : "#113311"
            },
            "layout" : {
                "dir" : "horizontal"
            },
            "line" : { "length" : 12, "padding-left" : 4 },
            "input" : { "align" : "left" }
        </style>
        <template name="definicion">
            <p class="p" padding="1">{{ ctx }}</p>
        </template>
        <code command="/usr/bin/bash" name="buscar">
            <envs>
                <st-env name="palabra" />
            </envs>
            <args>
                <arg>-c</arg>
                <arg>
                    <![CDATA[ 
                        curl -s "https://rae-api.com/api/words/${palabra}" |jq -r ".data.meanings[].senses[].raw" 2>> /tmp/err_rt

                        exit 0
                    ]]>
                </arg>
            </args>
        </code>
    </head>
    <body dir="horizontal" flex="center" padding="1">
        <border title="Diccionario" dir="vertical" max="60" flex="start" padding-top="1">
            <layout flex="center" length="2" padding-bottom="1">
                <line>Buscar:</line>
                <input id="palabra" enter="buscar" enter-envs="palabra" enter-replace-childs="definicion" enter-template="definicion" />
            </layout>
            <layout id="definicion" flex="center" dir="vertical">

            </layout>
        </border>
    </body>
</rtml>